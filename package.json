{
  "name": "mdmaker",
  "version": "1.0.0",
  "description": "WYSIWYG Markdown editor that writes clean, consistent Markdown",
  "main": "./out/main/index.js",
  "author": "5voltFX",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/5voltfx/MDMaker.git"
  },
  "homepage": "https://github.com/5voltfx/MDMaker#readme",
  "bugs": "https://github.com/5voltfx/MDMaker/issues",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && electron-vite build",
    "build:mac": "npm run build && electron-builder --mac --universal",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.9",
    "@tiptap/extension-code-block-lowlight": "^3.30.2",
    "@tiptap/extension-image": "^3.30.2",
    "@tiptap/extension-placeholder": "^3.30.2",
    "@tiptap/extension-table": "^3.30.2",
    "@tiptap/extension-task-item": "^3.30.2",
    "@tiptap/extension-task-list": "^3.30.2",
    "@tiptap/pm": "^3.30.2",
    "@tiptap/react": "^3.30.2",
    "@tiptap/starter-kit": "^3.30.2",
    "@uiw/react-codemirror": "^4.25.11",
    "codemirror": "^6.0.2",
    "hast-util-to-mdast": "^10.1.2",
    "lowlight": "^3.3.0",
    "mdast-util-to-markdown": "^2.1.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "rehype-parse": "^9.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-remark": "^10.0.1",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "remark-stringify": "^11.0.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "jsdom": "^27.0.1",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "vitest": "^3.2.7"
  }
